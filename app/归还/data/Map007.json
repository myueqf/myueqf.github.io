{"id":1,"name":"NE2结局流程","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["                  "]},{"code":401,"indent":0,"parameters":["                  烟雾中，逐渐有人影浮现出来。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["阿瑶？"]},{"code":101,"indent":0,"parameters":["",0,0,2,"？"]},{"code":401,"indent":0,"parameters":["二哥？"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["是你吗？"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["                  "]},{"code":401,"indent":0,"parameters":["                  烟雾逐渐散去。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["                  "]},{"code":401,"indent":0,"parameters":["                  站在那里的，正是金光瑶。"]},{"code":101,"indent":0,"parameters":["yao2",4,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["二哥.........这是，怎么回事？"]},{"code":101,"indent":0,"parameters":["xi",5,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["嗯？"]},{"code":101,"indent":0,"parameters":["yao2",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["咳咳......我怎么在寒室？"]},{"code":401,"indent":0,"parameters":["还穿着你的衣服....."]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["不是我的衣服，是我替你准备的新衣服。"]},{"code":101,"indent":0,"parameters":["xi",5,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["好像是有些大了？"]},{"code":101,"indent":0,"parameters":["yao2",4,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":[".........是的。"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["也不碍事，我调整一下，还是能穿的。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["阿瑶还记得过去一段时间发生的事吗？"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["唔.............."]},{"code":101,"indent":0,"parameters":["yao2",4,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["现在脑子有些乱乱的......."]},{"code":401,"indent":0,"parameters":["容我想想......."]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["不着急，我们还有很多时间。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["我先给你泡壶茶吧。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["                  "]},{"code":401,"indent":0,"parameters":["                  一盏茶的时间"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["多谢泽芜君，我已经理清楚了"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你没事就好，之后可有打算？"]},{"code":101,"indent":0,"parameters":["yao2",5,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["嗯，我准备离开这里。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["..............."]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["这样啊....."]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["说要离开....你是打算去哪里？"]},{"code":101,"indent":0,"parameters":["yao2",5,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["嗯..........."]},{"code":401,"indent":0,"parameters":["这倒是，一时没有头绪"]},{"code":101,"indent":0,"parameters":["yao2",5,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["如今这个局势，我也不可能再在这里待下去了。"]},{"code":101,"indent":0,"parameters":["yao2",5,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["在这难免给泽芜君添麻烦，引得外人议论。"]},{"code":101,"indent":0,"parameters":["yao2",4,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["何况我想，应该有不少人是不想在蓝家见到我的吧....."]},{"code":101,"indent":0,"parameters":["xi",3,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["这个你不必担心，无论何人，我护着你。"]},{"code":101,"indent":0,"parameters":["yao2",5,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["唔............"]},{"code":401,"indent":0,"parameters":["我还是想找个小院，具体位置随便什么地方都行，"]},{"code":401,"indent":0,"parameters":["就像当初你我遇见时我住的那个地方。"]},{"code":101,"indent":0,"parameters":["yao2",4,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["仙门这些事，我已经不想参与哪怕一点了。"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["像普通人一样过一生也很好。"]},{"code":101,"indent":0,"parameters":["xi",3,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["所以你是想远离仙门，过隐居生活吗？"]},{"code":101,"indent":0,"parameters":["yao2",4,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["能算隐居吗........."]},{"code":401,"indent":0,"parameters":["硬要说确实差不多吧。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["阿瑶，要不要再考虑一下？"]},{"code":401,"indent":0,"parameters":["你呆在云深，我可以保证那些事不会再来叨扰你。"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["多谢泽芜君美意，我想还是不必了。"]},{"code":101,"indent":0,"parameters":["xi",3,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["好吧。"]},{"code":401,"indent":0,"parameters":["我尊重你的选择。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  我替他准备了一间带小院的屋子"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  就在姑苏，但离云深还是有些距离"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  他搬到那里之后，又把自己的名字改回孟瑶"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  我经常会带着东西去看他，但他让我不必常来"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  后来他也逐渐有了自己新的生活圈，渐渐融入当地环境"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  不入仙门，他也能过得很好啊"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  或许这就是他原本的生活吧"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  祝你平安喜乐，无病无灾。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  阿瑶。"]},{"code":231,"indent":0,"parameters":[1,"NE2",1,0,408,312,100,100,255,0]},{"code":230,"indent":0,"parameters":[240]},{"code":235,"indent":0,"parameters":[1]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  这样的结局，是否如我所愿？"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["普通结局2："]},{"code":401,"indent":0,"parameters":["         隐姓埋名"]},{"code":354,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":1,"y":3}
