{"id":1,"name":"EV001","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":231,"indent":0,"parameters":[1,"ZC",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["xi",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["\\C[1]嗯。"]},{"code":401,"indent":0,"parameters":["今天的进度也很顺利，一切都安排好了。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["阿瑶，你睡了吗？"]},{"code":101,"indent":0,"parameters":["yao",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["我记得蓝家家规不是说，食不言寝不语。"]},{"code":101,"indent":0,"parameters":["yao",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["蓝宗主，你又破一次戒了。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["是吗？阿瑶还帮我记着呢。"]},{"code":101,"indent":0,"parameters":["yao",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["没~有。"]},{"code":401,"indent":0,"parameters":["毕竟我也不知道蓝家到底有多少规矩。"]},{"code":101,"indent":0,"parameters":["yao",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["我的眼睛，也不可能老盯着蓝宗主转吧。"]},{"code":101,"indent":0,"parameters":["yao",7,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["只不过我回来之后，蓝宗主你好像老是在犯错。"]},{"code":401,"indent":0,"parameters":["犯的我都记住了。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["劳烦阿瑶监督，下不为例"]},{"code":101,"indent":0,"parameters":["yao",7,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["怎么回事，这句话，好耳熟啊。"]},{"code":101,"indent":0,"parameters":["yao",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["蓝宗主，你一边说着下不为例，一边和我同床共枕。"]},{"code":401,"indent":0,"parameters":["听着不可信呢。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["这个啊...我正要问你的就是这个事。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["关于仪式...你是怎么想的"]},{"code":101,"indent":0,"parameters":["yao",1,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["你猜。猜中了就告诉你~"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你的心思，我猜不透。"]},{"code":101,"indent":0,"parameters":["yao",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["我想也是。"]},{"code":401,"indent":0,"parameters":["算了，告诉你吧。"]},{"code":401,"indent":0,"parameters":["我的回答就是，看 心 情。"]},{"code":101,"indent":0,"parameters":["yao",1,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["其他的，无可奉告。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["看心情？"]},{"code":101,"indent":0,"parameters":["yao",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["心情好就配合你。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["阿瑶....现在这样终究不是长久之计。"]},{"code":101,"indent":0,"parameters":["yao",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["那又如何？"]},{"code":401,"indent":0,"parameters":["我是已经死的鬼，比起在人间继续过这糟心的日子。"]},{"code":401,"indent":0,"parameters":["我还可以选择投胎转世。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你就真的.....不愿意吗......."]},{"code":401,"indent":0,"parameters":["这世间，应当还有你的执念————————"]},{"code":101,"indent":0,"parameters":["yao",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["在我看来，你的执念，可比我深多了。"]},{"code":230,"indent":0,"parameters":[120]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                        \\C[1]执念啊............."]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                        \\C[1]我确实对复活金光瑶有执念"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["          \\C[1]不仅是为了报救命之恩，不仅是为了错信而伤他的愧疚"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                        \\C[1]最重要的，是为了未宣之于口的感情"]},{"code":101,"indent":0,"parameters":["",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["............我就是如此的人啊，对自己的义兄也心存妄念。"]},{"code":401,"indent":0,"parameters":["甚至相交这么多年，也没勇气说出来。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["回望我那一生，步步谨慎........"]},{"code":401,"indent":0,"parameters":["但凡走错，又会从高台跌落一次。"]},{"code":401,"indent":0,"parameters":["我不敢赌，也怕你的厌弃，或许连朋友都做不成。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["如今已经死了，无所顾忌，反而能干脆的说出来了。"]},{"code":401,"indent":0,"parameters":["哈哈哈哈哈哈.........太可笑了...."]},{"code":101,"indent":0,"parameters":["",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["..............................................."]},{"code":101,"indent":0,"parameters":["",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["我也，不敢赌。"]},{"code":101,"indent":0,"parameters":["",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["心怀妄念的，又怎么会只有你一个呢？"]},{"code":401,"indent":0,"parameters":["我何尝不是............."]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                        \\C[1]何尝不是喜欢你许久....."]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["\\C[1]啊........................"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["\\C[1]细想来，我们两人能同时对对方保有这种感情这么多年，"]},{"code":401,"indent":0,"parameters":["未尝不是心有灵犀........"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["\\C[1]...............如果我能早点说出来。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["\\C[1]就不至于落到死后再来表白心意的地步。"]},{"code":235,"indent":0,"parameters":[1]},{"code":201,"indent":0,"parameters":[0,15,8,6,2,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":6,"y":4}
