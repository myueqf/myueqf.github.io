,0,2,"蓝忘机"]},{"code":401,"indent":0,"parameters":["好。"]},{"code":101,"indent":0,"parameters":["xi",5,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["对了..."]},{"code":401,"indent":0,"parameters":["叔父他没事吧？"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["连着几天，他老人家都不愿见我。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["是在生气吧....希望别气到了身体......"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["忘机你去见他的时候，也替我向他问好。"]},{"code":101,"indent":0,"parameters":["other",0,0,2,"蓝忘机"]},{"code":401,"indent":0,"parameters":["嗯。"]},{"code":235,"indent":0,"parameters":[1]},{"code":201,"indent":0,"parameters":[0,14,6,3,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":2,"y":3}
