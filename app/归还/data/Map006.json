ers":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["也不碍事，我调整一下，还是能穿的。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["阿瑶还记得过去一段时间发生的事吗？"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["唔.............."]},{"code":101,"indent":0,"parameters":["yao2",4,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["现在脑子有些乱乱的......."]},{"code":401,"indent":0,"parameters":["容我想想......."]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["不着急，我们还有很多时间。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["我先给你泡壶茶吧。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["                  "]},{"code":401,"indent":0,"parameters":["                  一盏茶的时间"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  他快速地理清了自己的思绪"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  阿瑶和以前一样，头脑反应很快"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  他是真的很聪明的一个人"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["多谢二哥，我已经好多了"]},{"code":401,"indent":0,"parameters":["整理之后，思绪也清晰了不少"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["那就好"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你能回来，真的太好了。"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["我能回来，还是仰仗二哥相助"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["我还以为......"]},{"code":401,"indent":0,"parameters":["再也没机会喊你二哥了。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你我之间，本就是些误会罢了"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你若是愿意说出来，我定会与你一起解决。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["阿瑶之后打算怎么安排？"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["我打算回金家。"]},{"code":101,"indent":0,"parameters":["xi",5,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["嗯？"]},{"code":401,"indent":0,"parameters":["为什么回去"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["把我没做完的事交给金凌那小子，"]},{"code":401,"indent":0,"parameters":["还是不太放心。"]},{"code":101,"indent":0,"parameters":["xi",3,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你现在回去，或许会遇到些阻碍"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["有二哥在嘛~"]},{"code":401,"indent":0,"parameters":["可要麻烦泽芜君当我这个大恶人的后盾咯。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["此话怎讲？"]},{"code":401,"indent":0,"parameters":["你我不是兄弟亦是挚友，我愿意支持你。"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["多谢泽芜君。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  阿瑶修整好后便孤身下山回到金家"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  我担心金家会和以前一样难为他，常找些理由去金麟台看看"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  但事情发展的比我预想的要顺利"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["          金家内部很快就重新接受了阿瑶