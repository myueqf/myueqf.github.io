ers":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["也不碍事，我调整一下，还是能穿的。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["阿瑶还记得过去一段时间发生的事吗？"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["唔.............."]},{"code":101,"indent":0,"parameters":["yao2",4,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["现在脑子有些乱乱的......."]},{"code":401,"indent":0,"parameters":["容我想想......."]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["不着急，我们还有很多时间。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["我先给你泡壶茶吧。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["                  "]},{"code":401,"indent":0,"parameters":["                  一盏茶的时间"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  他快速地理清了自己的思绪"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  阿瑶和以前一样，头脑反应很快"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["                  他是真的很聪明的一个人"]},{"code":101,"indent":0,"parameters":["yao2",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["咳咳.....二哥？"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["嗯？"]},{"code":101,"indent":0,"parameters":["yao2",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["从刚才起二哥就一直看着我笑......"]},{"code":401,"indent":0,"parameters":["是我有哪里不对吗？"]},{"code":101,"indent":0,"parameters":["xi",6,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["............"]},{"code":401,"indent":0,"parameters":["没有没有....."]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"par