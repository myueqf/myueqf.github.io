{"id":1,"name":"DAY2过场","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":231,"indent":0,"parameters":[1,"CG2",0,0,0,0,100,100,255,0]},{"code":101,"indent":0,"parameters":["other",1,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["先生！"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["小孟？"]},{"code":401,"indent":0,"parameters":["休息的如何？"]},{"code":101,"indent":0,"parameters":["other",1,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["休息的很好！我现在可有精神了！"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["那就好。"]},{"code":101,"indent":0,"parameters":["xi",3,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["害怕吗？"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["嗯......是仪式的事吗？"]},{"code":101,"indent":0,"parameters":["other",3,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["不怕！有先生和哥哥在。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["嗯。"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["先生....怎么了？"]},{"code":401,"indent":0,"parameters":["又和哥哥吵架了吗？"]},{"code":101,"indent":0,"parameters":["xi",5,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["又？.....没有的事。"]},{"code":401,"indent":0,"parameters":["是你哥哥和你说的吗？"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["没有，我看您的脸色不好。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["没有吵架，只是...."]},{"code":401,"indent":0,"parameters":["我还不知道他到底是怎么想的。"]},{"code":101,"indent":0,"parameters":["other",1,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["先生不用担心啊，他会配合的！"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你去替我说话了吗？谢谢。"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["没有，我才说不过他呢。"]},{"code":401,"indent":0,"parameters":["每次惹他不开心，就开口教训上我了。"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["我以后居然是嘴皮子这么厉害的人吗......."]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你哥哥的嘴，确实很厉害。"]},{"code":101,"indent":0,"parameters":["other",3,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["不过，无论变成什么样，他都是以后的我自己嘛！"]},{"code":401,"indent":0,"parameters":["有些东西一定是一样的。"]},{"code":101,"indent":0,"parameters":["other",3,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["我喜欢先生，所以他肯定也是。"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["只是......脾气比较大。"]},{"code":401,"indent":0,"parameters":["这点我也不喜欢。"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["但是好羡慕啊........"]},{"code":401,"indent":0,"parameters":[".........想发脾气就能发脾气......"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["不行不行！"]},{"code":401,"indent":0,"parameters":["母亲说过了，真正的君子才不会随便就发脾气！"]},{"code":401,"indent":0,"parameters":["书上也说，“小不忍则乱大谋”。"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["他就是脾气太大才变成那样呢。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["........不能这么说。"]},{"code":401,"indent":0,"parameters":["你哥哥他.......过去不是这个样子的。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["非要说的话，我认为他的脾气比我好得多。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["我从没看过他生气，连声量大的时候都很少。"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["先生是被他骗了吧。"]},{"code":401,"indent":0,"parameters":["他那样子才不是一天就变成的呢！"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["是啊........"]},{"code":401,"indent":0,"parameters":["他一直在我面前掩盖自己的负面情绪。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["我能见到的只有笑着的样子........."]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["他如今这样，应该也是压抑太久造成的吧。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["他有委屈，有气愤，有不甘......但是都不能表现出来"]},{"code":401,"indent":0,"parameters":["一直的忍，忍到如今...."]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["怨气冲天......"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["如果我能早些意识到，那不是他真正的情绪，"]},{"code":401,"indent":0,"parameters":["能早些帮上他，就好了......."]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["或许他也不至于什么事都一个人扛......"]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["先生........."]},{"code":101,"indent":0,"parameters":["other",2,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["先生不用自责，这不是您的问题呀。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["唉..........."]},{"code":401,"indent":0,"parameters":["或者我早些同他表明心意，就不至于此了。"]},{"code":101,"indent":0,"parameters":["other",3,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["没事的先生，现在互通也不迟。"]},{"code":101,"indent":0,"parameters":["other",1,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["母亲常说一切都会好起来的！我也是这么相信的。"]},{"code":401,"indent":0,"parameters":["现在只是短暂的痛苦，忍忍就可以过去了。"]},{"code":101,"indent":0,"parameters":["other",3,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["仪式也会成功的！"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["嗯！"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["小孟也要好好休息。"]},{"code":101,"indent":0,"parameters":["other",3,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["好！"]},{"code":101,"indent":0,"parameters":["other",3,0,2,"小孟"]},{"code":401,"indent":0,"parameters":["先生，如果我真的能遇到你这样的老师就好了。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["............................."]},{"code":235,"indent":0,"parameters":[1]},{"code":201,"indent":0,"parameters":[0,18,6,3,0,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":2,"y":3}
