parameters":["yao",6,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["这破世道，哪有什么应得的对待。"]},{"code":101,"indent":0,"parameters":["yao",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["说来我也见过一个孩子呢，天真纯洁，温柔善良，"]},{"code":401,"indent":0,"parameters":["结果被别人把家烧了追的到处跑。"]},{"code":101,"indent":0,"parameters":["yao",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["这也应得吗？"]},{"code":101,"indent":0,"parameters":["xi",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["............................."]},{"code":101,"indent":0,"parameters":["xi",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["唉........"]},{"code":101,"indent":0,"parameters":["yao",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["你是想弥补我，还是在心疼我？"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["心疼你。"]},{"code":401,"indent":0,"parameters":["如果不是小孟，你以前的事，我永远不会知道。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你以前是个什么样的人？过着什么样的日子？"]},{"code":401,"indent":0,"parameters":["包括你的母亲————————————"]},{"code":101,"indent":0,"parameters":["yao",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["好了好了。"]},{"code":401,"indent":0,"parameters":["给我留点隐私吧。"]},{"code":101,"indent":0,"parameters":["yao",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["本来我都把过去烧掉了，一个两个都要挖出来看看。"]},{"code":401,"indent":0,"parameters":["现在知道了，满意了吧？"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["我希望，能更了解你一点。"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["很想知道你到底是怎么想的"]},{"code":101,"indent":0,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["我想了解你的过去，也想参与你的未来————————"]},{"code":101,"indent":0,"parameters":["yao",6,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["咳咳咳！打住打住。"]},{"code":401,"indent":0,"parameters":["不要在我们睡在同一个被窝的时候说这么暧昧的话。"]},{"code":401,"indent":0,"parameters":["有什么不能明天起来再说吗？"]},{"code":101,"indent":0,"parameters":["yao",2,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["早知道泽芜君现学现用的能力这么强，"]},{"code":401,"indent":0,"parameters":["就不推荐你看那本书了。"]},{"code":102,"indent":0,"parameters":[["顺着他换个话题","坚持说完"],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"顺着他换个话题"]},{"code":101,"indent":1,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":1,"parameters":["........................."]},{"code":401,"indent":1,"parameters":["明天吗？"]},{"code":401,"indent":1,"parameters":["你的意思是愿意参与仪式？"]},{"code":101,"indent":1,"parameters":["yao",2,0,2,"金光瑶"]},{"code":401,"indent":1,"parameters":["是。"]},{"code":401,"indent":1,"parameters":["唉，小孟不都和你说了吗。"]},{"code":401,"indent":1,"parameters":["我的想法和他的想法，不会差到哪里去的。"]},{"code":101,"indent":1,"parameters":["yao",0,0,2,"金光瑶"]},{"code":401,"indent":1,"parameters":["何况我这两天，心情还不错~"]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"坚持说完"]},{"code":101,"indent":1,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":1,"parameters":["阿瑶................."]},{"code":101,"indent":1,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":1,"parameters":["这，是我的真心话。"]},{"code":101,"indent":1,"parameters":["other",7,0,2,"蓝曦臣"]},{"code":401,"indent":1,"parameters":["我想和你有未来。"]},{"code":101,"indent":1,"parameters":["yao",6,0,2,"金光瑶"]},{"code":401,"indent":1,"parameters":["................................."]},{"code":401,"indent":1,"parameters":["........................................."]},{"code":401,"indent":1,"parameters":["................................................"]},{"code":126,"indent":1,"parameters":[3,0,0,1]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"parameters":["            \\C[1]不知为何，今天入睡格外地快"]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":[""]},{"code":401,"indent":0,"pa