ters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["也不碍事，我调整一下，还是能穿的。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["阿瑶还记得过去一段时间发生的事吗？"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["唔.............."]},{"code":101,"indent":0,"parameters":["yao2",4,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["现在脑子有些乱乱的......."]},{"code":401,"indent":0,"parameters":["容我想想......."]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["不着急，我们还有很多时间。"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["我先给你泡壶茶吧。"]},{"code":101,"indent":0,"parameters":["",0,0,1,""]},{"code":401,"indent":0,"parameters":["                  "]},{"code":401,"indent":0,"parameters":["                  一盏茶的时间"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["多谢泽芜君，我已经理清楚了"]},{"code":101,"indent":0,"parameters":["xi",0,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["你没事就好，之后可有打算？"]},{"code":101,"indent":0,"parameters":["yao2",5,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["嗯，我准备离开这里。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["..............."]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["这样啊....."]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":["说要离开....你是打算去哪里？"]},{"code":101,"indent":0,"parameters":["yao2",5,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["东瀛。"]},{"code":101,"indent":0,"parameters":["yao2",0,0,2,"金光瑶"]},{"code":401,"indent":0,"parameters":["泽芜君无须担心，这件事我早已打点好了。"]},{"code":401,"indent":0,"parameters":["虽然要带的旧部心腹不在，我一个人应当也没什么问题。"]},{"code":101,"indent":0,"parameters":["xi",2,0,2,"蓝曦臣"]},{"code":401,"indent":0,"parameters":[".........................是吗？"]},{"code":401,"indent":0,"parameters":[